}
//function to move the tortoise
void moveTort( int * position,  int randomNumber){
    
    //checks the generated number to see which move to perform
    //Then it changes the position value
    if(randomNumber>=1&&randomNumber<=5){
        cout<<"Tortoise: Fast Plod\n";
        *position+=3;
        
    }
    else if(randomNumber==6||randomNumber==7){
        cout<<"Tortoise: Slips\n";
        *position-=6;
        if(*position<1){
            *position=1;
        }
         
    }
    else{
        cout<<"Tortoise: Slow pod\n";
        *position+=1;
        
    }

}

//function to move the Hare
void moveHare( int * position,  int randomNumber){
    
     //checks the generated number to see which move to perform
    //Then it changes the position value
    if(randomNumber>=1&&randomNumber<=2){
        cout<<"Hare: Sleep\n";
        *position+=0;
         
    }
    else if(randomNumber>=3&&randomNumber<=4){
        cout<<"Hare: Big Hop\n";
        *position+=9;
       
    }
    else if(randomNumber==5){
        cout<<"Hare: Big Slip\n";
        *position-=12;
        if(*position<1){
            *position=1;
        }
        
    }
    else if(randomNumber>=6&&randomNumber<=8){
        cout<<"Hare: Small Hop\n";
        *position+=1;
        
    }
    else if(randomNumber<=9&&randomNumber<=10){
        cout<<"Hare: Small Slip\n";
        *position-=1;
        if(*position<1){
            *position=1;
        }
        
    }
    
}
