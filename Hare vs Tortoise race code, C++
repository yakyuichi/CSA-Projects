            int pos = tort - 1;

            //if statement that checks if the position is greater than zero AND less 70
            if (pos >= 0 && pos < 70) {
               
               //if the condition is met then it replaces that position and prints "OUCH"
                map.replace(pos, 70 - pos < 7 ? 70 - pos : 7, "OUCH!!!");
            }
