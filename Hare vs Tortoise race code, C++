    uniform_int_distribution<int> distrib(1, 10);
    int randNumValue=distrib(gen);

   

    //I used a while loop to continuously run the program until it came back as false
     while (go) {
        
    //these lines generate a random number for the moveHare and moveTort
    int hareRandNum=distrib(gen);
    int tortRandNum=distrib(gen);

        //Calls the functions
        moveTort(&tort,tortRandNum);
        moveHare(&hare,hareRandNum);

